; The shell owns its HUD chrome, so the shell owns where the world may be
; drawn without being covered by it. These insets clear the top rail and cue
; banner, the resource plate, and the edge launchers, so a view's own banner
; and status line stay legible and no addressable rectangle sits under a
; button. A view is never told about the HUD; it is given a rectangle.
[node name="WorldViewHost" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 96.0
offset_top = 108.0
offset_right = -96.0
offset_bottom = -132.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

