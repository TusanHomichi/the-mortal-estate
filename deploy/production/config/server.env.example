TME_PUBLIC_HOST=REQUIRED
TME_PUBLIC_ORIGIN=https://REQUIRED
TME_ACME_PROFILE=shortlived
TME_OPERATOR_SSH_CIDR=REQUIRED
TME_BACKUP_REPOSITORY=REQUIRED_OFF_HOST_FAILURE_DOMAIN
TME_BACKUP_REPOSITORY_KIND=s3
TME_RELEASE_ID=REQUIRED_IMMUTABLE_RELEASE_ID
TME_PUBLIC_LISTEN=127.0.0.1:8080
TME_OPS_LISTEN=127.0.0.1:9090
TME_DATABASE_SOCKET=/var/run/postgresql
TME_DATABASE_NAME=tme
TME_BOOTSTRAP_MANIFEST=/etc/tme/bootstrap.json
TME_BANNED_TERMS_FILE=/etc/tme/banned-terms.txt
TME_RECOVERY_KEY_ESCROW_ACK=REQUIRED
