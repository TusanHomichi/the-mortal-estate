[global]
repo1-type=s3
repo1-s3-endpoint=REQUIRED_OFF_HOST_ENDPOINT
repo1-s3-bucket=REQUIRED_OFF_HOST_BUCKET
repo1-s3-region=REQUIRED_REGION
repo1-s3-key=REQUIRED_FROM_ROOT_OWNED_SECRET_INPUT
repo1-s3-key-secret=REQUIRED_FROM_ROOT_OWNED_SECRET_INPUT
repo1-path=/tme
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REQUIRED_FROM_ENCRYPTED_ESCROW
repo1-retention-full=6
repo1-retention-diff=4
repo1-retention-archive-type=full
repo1-retention-archive=6
archive-async=y
spool-path=/var/spool/pgbackrest
process-max=2
start-fast=y
log-level-console=info
log-level-file=detail
log-path=/var/log/pgbackrest

[tme]
pg1-path=/var/lib/postgresql/18/main
pg1-port=5432
