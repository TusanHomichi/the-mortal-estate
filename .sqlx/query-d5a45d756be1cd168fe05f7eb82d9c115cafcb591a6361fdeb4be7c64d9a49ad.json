  "query": "\n        SELECT request_digest AS \"request_digest!\",\n               disposition AS \"disposition!\",\n               outcome_bytes,\n               (full_expires_at <= statement_timestamp()) AS \"full_expired!\"\n        FROM tme.command_receipts\n        WHERE account_id = $1 AND command_id = $2\n        FOR UPDATE\n        ",
